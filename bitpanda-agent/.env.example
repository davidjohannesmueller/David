# ── Safety ─────────────────────────────────────────────────────────────
# "true"  = simulate only, never send real orders (STRONGLY recommended)
# "false" = send REAL orders. Only after full paper-trading validation.
DRY_RUN=true

# ── Alpaca (US stocks/ETFs + crypto) ───────────────────────────────────
# Free paper-trading keys: https://alpaca.markets/  (Paper account)
ALPACA_API_KEY=your_alpaca_key
ALPACA_API_SECRET=your_alpaca_secret
# Paper endpoint by default. Switch to https://api.alpaca.markets for live.
ALPACA_TRADING_URL=https://paper-api.alpaca.markets
ALPACA_DATA_URL=https://data.alpaca.markets

# ── OANDA (forex) ───────────────────────────────────────────────────────
# Free practice account: https://www.oanda.com/  (fxTrade Practice)
OANDA_API_TOKEN=your_oanda_practice_token
OANDA_ACCOUNT_ID=your_oanda_account_id
OANDA_REST_URL=https://api-fxpractice.oanda.com

# ── Bitpanda / One Trading (EU crypto live, optional) ──────────────────
ONETRADING_API_KEY=your_onetrading_key
ONETRADING_REST_URL=https://api.exchange.bitpanda.com/public/v1
