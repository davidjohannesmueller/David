# ── Bitpanda / One Trading API credentials ─────────────────────────────
# Create an API key in your One Trading (formerly Bitpanda Pro) account.
# Give it ONLY the scopes you need. NEVER commit the real .env file.
ONETRADING_API_KEY=your_api_key_here

# REST base URL. Default works for the legacy Bitpanda Pro host; switch to
# the One Trading host if your key was issued there.
ONETRADING_REST_URL=https://api.exchange.bitpanda.com/public/v1
# ONETRADING_REST_URL=https://api.onetrading.com/fast/v1

# ── Safety ─────────────────────────────────────────────────────────────
# "true"  = simulate only, never send real orders (STRONGLY recommended)
# "false" = send REAL orders with REAL money. Only after full testing.
DRY_RUN=true
